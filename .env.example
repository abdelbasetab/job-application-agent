# Copy to .env for local development. Never commit .env or real credentials.

# ---- LLM (optional; deterministic mode is the safe default) ----
# Providers: ollama | openai | kiconnect | anthropic | groq
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.2
LLM_CALL_TIMEOUT=45
LLM_BASE_URL=http://127.0.0.1:11434
ENABLE_LLM_AGENTS=false
ENABLE_PROFILE_MEMORY=false
EMBEDDING_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# ---- Job sources ----
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=de
BA_JOBSUCHE_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/pc/v4
BA_JOBSUCHE_API_KEY=jobboerse-jobsuche
ENABLE_SCRAPER=false
SCRAPER_MIN_INTERVAL=2.0
LIVENESS_DEEP=false
ALLOW_PRIVATE_NETWORK_SERVICES=false

# ---- Persistent storage ----
SQLITE_PATH=./data/job_agent.db
PROFILE_INDEX_PATH=./data/profile_index
JOB_AGENT_DATA_DIR=./data

# ---- Web ----
WEB_HOST=127.0.0.1
WEB_PORT=7860
# Keep public self-registration off. On the first start either temporarily set
# it true locally, or provide both bootstrap values via a secret manager.
WEB_ALLOW_REGISTRATION=false
WEB_BOOTSTRAP_EMAIL=
WEB_BOOTSTRAP_PASSWORD=
# Set true only when the browser reaches the app through HTTPS.
WEB_SECURE_COOKIES=false

# ---- CLI-only operator mail defaults ----
# Authenticated web users configure isolated credentials and policies in the UI;
# they never inherit these secrets.
EMAIL_DRY_RUN=true
EMAIL_DEMO_RECIPIENT=demo-recipient@example.invalid
# Fixed self-review target: application/follow-up mail never goes to an
# employer, it always goes here (job details + cover letter PDF + CV).
EMAIL_REVIEW_RECIPIENT=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_SYNC_DRY_RUN=true
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=
EMAIL_IMAP_PASSWORD=
EMAIL_IMAP_FOLDER=INBOX
EMAIL_SYNC_LIMIT=50
EMAIL_AUTO_FOLLOW_UP_SEND=false
EMAIL_AUTOPILOT_INTERVAL_MINUTES=15

# ---- Optional Gmail / Microsoft OAuth ----
# Must be the externally visible HTTPS origin in production, without path.
EMAIL_OAUTH_REDIRECT_BASE=
EMAIL_OAUTH_GOOGLE_CLIENT_ID=
EMAIL_OAUTH_GOOGLE_CLIENT_SECRET=
EMAIL_OAUTH_MICROSOFT_CLIENT_ID=
EMAIL_OAUTH_MICROSOFT_CLIENT_SECRET=
