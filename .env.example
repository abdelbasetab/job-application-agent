# ---- LLM provider ----
# Switch between providers without code changes.
# One of: ollama (default) | openai | kiconnect | anthropic | groq
LLM_PROVIDER=kiconnect

# Model name — must match what the chosen provider expects.
#   ollama:    qwen2.5:7b-instruct   (run `ollama pull qwen2.5:7b-instruct` once)
#   openai:    gpt-4o-mini           (or gpt-4o)
#   kiconnect: <the model id your KI-Connect gateway exposes, e.g. gpt-4o-mini>
#   anthropic: claude-sonnet-4-6     (or claude-haiku-4-5 for cheap calls)
#   groq:      llama-3.3-70b-versatile
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2
LLM_CALL_TIMEOUT=60
# Sprint 3 agents (LLM matcher + writer). CV reading (--cv) always uses the LLM.
ENABLE_LLM_AGENTS=true
ENABLE_CHROMA=false

# Endpoint override. REQUIRED for kiconnect (your gateway's OpenAI-compatible
# base URL, usually ending in /v1). Also used by Ollama / self-hosted gateways.
# Examples:
#   ollama:    http://localhost:11434
#   kiconnect: https://<your-kiconnect-host>/v1
LLM_BASE_URL=https://<your-kiconnect-host>/v1

# ---- Provider keys (only needed for the provider you select) ----
# openai AND kiconnect both read OPENAI_API_KEY (KI-Connect is OpenAI-compatible).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=your-kiconnect-api-key
GROQ_API_KEY=

# ---- Job APIs (Sprint 2) ----
# Adzuna: free dev keys at https://developer.adzuna.com/signup
# Without these, the Adzuna adapter logs a warning and returns [] —
# Scout can still run if BA-Jobsuche is reachable.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=de
# BA-Jobsuche: public endpoint. No signup needed, but every request must send a
# fixed X-API-Key header — the value below is public and the same for everyone.
# Without it the API responds with 403.
BA_JOBSUCHE_BASE_URL=https://rest.arbeitsagentur.de/jobboerse/jobsuche-service/pc/v4
BA_JOBSUCHE_API_KEY=jobboerse-jobsuche

# ---- Storage ----
SQLITE_PATH=./data/job_agent.db
CHROMA_PATH=./data/chroma_db

# ---- Optional: real embeddings for semantic RAG (--chroma) ----
# Empty = offline hash embeddings. A model your gateway exposes, e.g. KI-Connect:
#   EMBEDDING_MODEL=Qwen 3 Embedding 8B
#   EMBEDDING_MODEL=E5 Mistral 7B Instruct Inferenz.nrw
EMBEDDING_MODEL=Qwen 3 Embedding 8B

# ---- Optional polite detail-page scraper (ADR-0005). APIs stay primary. ----
ENABLE_SCRAPER=false
SCRAPER_MIN_INTERVAL=2.0

# ---- Optional Tracker email submission ----
# Safe default: dry-run prepares the email and records the event, but does not send.
EMAIL_DRY_RUN=true
EMAIL_DEMO_RECIPIENT=demo-recipient@example.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=true
EMAIL_SMTP_USER=your-email@example.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@example.com
