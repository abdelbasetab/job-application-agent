# Production overlay. Supply every secret through the hosting platform's secret
# manager; this file intentionally contains no usable credential.
WEB_HOST=0.0.0.0
WEB_PORT=7860
WEB_SECURE_COOKIES=true
WEB_ALLOW_REGISTRATION=false
WEB_BOOTSTRAP_EMAIL=
WEB_BOOTSTRAP_PASSWORD=
JOB_AGENT_DATA_DIR=/data
SQLITE_PATH=/data/job_agent.db
PROFILE_INDEX_PATH=/data/profile_index
ALLOW_PRIVATE_NETWORK_SERVICES=false

ENABLE_LLM_AGENTS=false
ENABLE_PROFILE_MEMORY=false
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
EMBEDDING_MODEL=

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=de

EMAIL_DRY_RUN=true
EMAIL_SYNC_DRY_RUN=true
EMAIL_AUTO_FOLLOW_UP_SEND=false
EMAIL_OAUTH_REDIRECT_BASE=
